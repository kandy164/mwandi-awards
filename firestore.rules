rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /votes/{uid} {
      // Each browser can create its own single vote, and never change or delete it.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['nominee', 'at'])
                    && request.resource.data.nominee in [
                         'nominee-01','nominee-02','nominee-03','nominee-04',
                         'nominee-05','nominee-06','nominee-07'];
      // A voter can read only their own vote (to know they already voted).
      allow get: if request.auth != null && request.auth.uid == uid;
      // Only the creator can list all votes to see totals.
      allow list: if request.auth != null
                  && request.auth.token.email == 'REPLACE_WITH_YOUR_EMAIL';
    }
  }
}
